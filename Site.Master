<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="Proyecto_Final_Josias_Cisneros.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - XTechnology</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:BundleReference runat="server" Path="~/Content/css" />
    <!-- Tema Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/lux/bootstrap.min.css" />
    <link href="~/Content/theme.css" rel="stylesheet" />

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%-- Framework Scripts --%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            <div class="container">
                <asp:HyperLink ID="hlBrand" runat="server" CssClass="navbar-brand"
                    NavigateUrl="~/Home.aspx" Text="XTechnology" />

                <button type="button" class="navbar-toggler" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse" title="Toggle navigation"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <% If Not autenticado Then %>
                        <!-- Menú para NO autenticados -->
                        <li class="nav-item">
                            <asp:HyperLink ID="hlRegistro" runat="server" CssClass="nav-link"
                                NavigateUrl="~/Registro.aspx" Text="Registro" />
                        </li>
                        <li class="nav-item">
                            <asp:HyperLink ID="hlLogin" runat="server" CssClass="nav-link"
                                NavigateUrl="~/Login.aspx" Text="Login" />
                        </li>
                        <% End If %>

                        <!-- Solo visible si es Admin  -->
                        <li class="nav-item" id="liAdmin" runat="server">
                            <asp:HyperLink ID="hlAdmin" runat="server" CssClass="nav-link"
                                NavigateUrl="~/Admin.aspx" Text="Admin" />
                        </li>

                        <% If autenticado Then %>

                        <!-- Catálogo: solo usuario normal  -->
                        <li class="nav-item" id="liCatalogo" runat="server">
                            <asp:HyperLink ID="hlCatalogo" runat="server" CssClass="nav-link"
                                NavigateUrl="~/Catalogo.aspx" Text="Catálogo" />
                        </li>

                        <!-- Carrito: solo usuario normal  -->
                        <li class="nav-item" id="liCarrito" runat="server">
                            <asp:HyperLink ID="hlCarrito" runat="server" CssClass="nav-link"
                                NavigateUrl="~/Carrito.aspx" Text="Carrito de compras" />
                        </li>

                        <!-- Productos: solo admin -->
                        <li class="nav-item" id="liProductos" runat="server">
                            <asp:HyperLink ID="hlProductos" runat="server" CssClass="nav-link"
                                NavigateUrl="~/FormProducto.aspx" Text="Productos" />
                        </li>

                        <!-- Clientes: solo admin -->
                        <li class="nav-item" id="liClientes" runat="server">
                            <asp:HyperLink ID="hlClientes" runat="server" CssClass="nav-link"
                                NavigateUrl="~/FormCliente.aspx" Text="Clientes" />
                        </li>

                        <!-- Pedidos: solo admin -->
                        <li class="nav-item" id="liPedidos" runat="server">
                            <asp:HyperLink ID="hlPedidos" runat="server" CssClass="nav-link"
                                NavigateUrl="~/FormPedido.aspx" Text="Pedidos" />
                        </li>

                        <!-- Cerrar sesión: cualquier autenticado -->
                        <li class="nav-item">
                            <asp:LinkButton ID="btnLogOut" runat="server"
                                CssClass="nav-link btn btn-danger ms-2"
                                OnClick="btnLogOut_Click">
                                Cerrar sesión
                            </asp:LinkButton>
                        </li>

                        <% End If %>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> - XTechnology</p>
            </footer>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
